[global]
max_icon_size = 560
icon_position = top
font = JetBrainsMono Nerd Font 11
frame_color = "#cba6f7"
frame_width = 2
corner_radius = 10
width = 600
origin = top-right
offset = 12x40
padding = 12
horizontal_padding = 12
separator_height = 2
markup = full
format = "<b>%s</b>\n%b"
show_indicators = no

[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"
timeout = 5

[urgency_normal]
background = "#313244"
foreground = "#cdd6f4"
timeout = 8

[urgency_critical]
background = "#f38ba8"
foreground = "#1e1e2e"
timeout = 0

# Moon popup: phase art beside the text instead of on top.
[moon_popup]
    appname = moon
    icon_position = right
