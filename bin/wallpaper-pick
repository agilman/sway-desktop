#!/usr/bin/env bash
# wallpaper-pick — season/date-aware weighted wallpaper picker for sway
#
# Pool rules (directories under $WALLPAPER_ROOT):
#   general/            always in the pool
#   spring|summer|fall|winter/   in the pool during that meteorological season
#   MMDD/ or MMDD-MMDD/ date dirs: in the pool only when today is in range
#                       (ranges wrap the year boundary if from > to; strict
#                       outside the range). Date dirs can sit anywhere under
#                       active directories.
#   any other dir name: not in the pool
# An image is eligible only if EVERY ancestor dir is active.
# Weight: product of all .weight files along the ancestor chain (default 1).
# Top-level files directly in the root are ignored.
set -euo pipefail

ROOT="${WALLPAPER_ROOT:-$HOME/Pictures/wallpaper}"
STATE_FILE="$HOME/.local/state/wallpaper-current"
PID_FILE="$HOME/.local/state/wallpaper-pick.pid"

SEASON=""
DATE_OVERRIDE=""
DRY_RUN=0
SIMULATE=0
NEXT=0

usage() {
  cat <<'EOF'
wallpaper-pick [options]
  --season NAME   force season (winter|spring|summer|fall) — testing only
  --date MMDD     pretend today is MMDD — testing only
  --next          exclude the current wallpaper from the pool (manual
                  "change wallpaper" — always shows something new unless
                  the pool has only one image)
  --dry-run       print the pool with weights, do not pick
  --simulate N    perform N weighted picks, print frequency table
  -h, --help      this help
EOF
}

valid_mmdd() {
  local m="${1:0:2}" d="${1:2:2}"
  [[ "$1" =~ ^[0-9]{4}$ ]] || return 1
  case "$m" in
    02) ((10#$d >= 1 && 10#$d <= 29)) ;;
    04|06|09|11) ((10#$d >= 1 && 10#$d <= 30)) ;;
    01|03|05|07|08|10|12) ((10#$d >= 1 && 10#$d <= 31)) ;;
    *) return 1 ;;
  esac
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --season)
      [[ $# -ge 2 && "$2" =~ ^(winter|spring|summer|fall)$ ]] ||
        { echo "wallpaper-pick: --season must be winter, spring, summer, or fall" >&2; exit 2; }
      SEASON="$2"; shift 2 ;;
    --date)
      [[ $# -ge 2 && "$2" =~ ^[0-9]{4}$ ]] && valid_mmdd "$2" ||
        { echo "wallpaper-pick: --date must be a valid MMDD" >&2; exit 2; }
      DATE_OVERRIDE="$2"; shift 2 ;;
    --dry-run)  DRY_RUN=1; shift ;;
    --next)     NEXT=1; shift ;;
    --simulate)
      [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] ||
        { echo "wallpaper-pick: --simulate must be a positive integer" >&2; exit 2; }
      SIMULATE="$2"; shift 2 ;;
    -h|--help)  usage; exit 0 ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

now_mmdd="${DATE_OVERRIDE:-$(date +%m%d)}"

if [[ -z "$SEASON" ]]; then
  # derive season from the (possibly simulated) date
  month=$(( 10#${now_mmdd:0:2} ))
  case "$month" in
    12|1|2) SEASON=winter ;;
    3|4|5)  SEASON=spring ;;
    6|7|8)  SEASON=summer ;;
    *)      SEASON=fall ;;
  esac
fi

# Print "FROM TO" if dir name is a date spec, else fail.
date_range_of() {
  local name="$1" from to
  if [[ "$name" =~ ^([0-9]{4})-([0-9]{4})$ ]]; then
    # capture first: valid_mmdd runs its own regex and clobbers BASH_REMATCH
    from="${BASH_REMATCH[1]}"; to="${BASH_REMATCH[2]}"
    valid_mmdd "$from" && valid_mmdd "$to" || return 1
    echo "$from $to"
  elif [[ "$name" =~ ^([0-9]{4})$ ]]; then
    from="${BASH_REMATCH[1]}"
    valid_mmdd "$from" || return 1
    echo "$from $from"
  else
    return 1
  fi
}

# in_range FROM TO — uses now_mmdd, handles year-boundary wrap
in_range() {
  local from="$1" to="$2"
  if [[ "$from" < "$to" || "$from" == "$to" ]]; then
    [[ ! "$now_mmdd" < "$from" && ! "$now_mmdd" > "$to" ]]
  else
    [[ ! "$now_mmdd" < "$from" || ! "$now_mmdd" > "$to" ]]
  fi
}

# dir_active NAME — is a single directory component active?
dir_active() {
  local name="$1" range
  [[ "$name" == "general" ]] && return 0
  [[ "$name" == "$SEASON" ]] && return 0
  if range=$(date_range_of "$name"); then
    in_range $range && return 0
    return 1
  fi
  return 1
}

POOL=()  # entries: "weight<TAB>path"

read_weight() {
  local value
  IFS= read -r value < "$1" || value=""
  if [[ "$value" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$ ]] &&
     awk -v v="$value" 'BEGIN { exit !(v >= 0 && v < 1e308) }'; then
    printf '%s' "$value"
  else
    printf '1'
  fi
}

scan_dir() {  # dir chain_active weight
  local dir="$1" active="$2" weight="$3" f base
  for f in "$dir"/*; do
    [[ -e "$f" ]] || continue
    base=$(basename "$f")
    if [[ -d "$f" && ! -L "$f" ]]; then
      local d_active=0 d_weight="$weight"
      if [[ "$active" == 1 ]] && dir_active "$base"; then
        d_active=1
        if [[ -f "$f/.weight" ]]; then
          local w
          w=$(read_weight "$f/.weight")
          d_weight=$(awk -v a="$weight" -v b="$w" 'BEGIN{printf "%g", a*b}')
        fi
      fi
      scan_dir "$f" "$d_active" "$d_weight"
    elif [[ "$active" == 1 ]]; then
      case "${base,,}" in
        *.jpg|*.jpeg|*.png|*.webp) POOL+=("$weight"$'\t'"$f") ;;
      esac
    fi
  done
}

# Only descend into active top-level dirs; top-level files are ignored.
for d in "$ROOT"/*/; do
  [[ -d "$d" && ! -L "$d" ]] || continue
  d="${d%/}"
  base=$(basename "$d")
  if dir_active "$base"; then
    w=1
    if [[ -f "$d/.weight" ]]; then
      w=$(read_weight "$d/.weight")
    fi
    scan_dir "$d" 1 "$w"
  fi
done

if [[ ${#POOL[@]} -eq 0 ]]; then
  echo "wallpaper-pick: pool is empty (season=$SEASON date=$now_mmdd root=$ROOT)" >&2
  exit 1
fi

if [[ "$NEXT" == 1 ]]; then
  # Manual "change wallpaper": exclude the current wallpaper from the pool.
  # Falls back to the full pool if it would end up empty (single-image pool).
  current=""
  if [[ -f "$STATE_FILE" ]]; then
    current=$(<"$STATE_FILE")
  fi
  if [[ -n "$current" ]]; then
    filtered=()
    for e in "${POOL[@]}"; do
      [[ "${e#*$'\t'}" == "$current" ]] || filtered+=("$e")
    done
    if [[ ${#filtered[@]} -gt 0 ]]; then
      POOL=("${filtered[@]}")
    fi
  fi
fi

total_weight=$(printf '%s\n' "${POOL[@]}" | awk -F'\t' '
  { total += $1 + 0 }
  END {
    if (!(total > 0) || total >= 1e308) exit 1
    printf "%g", total
  }') || {
    echo "wallpaper-pick: total pool weight is zero or invalid" >&2
    exit 1
  }

pick_one() {
  printf '%s\n' "${POOL[@]}" | awk -F'\t' -v seed="$RANDOM" '
    { w[NR]=$1+0; p[NR]=$2; total+=w[NR] }
    END {
      if (NR==0) exit 1
      if (!(total > 0) || total >= 1e308) {
        print "wallpaper-pick: total pool weight is zero or invalid" > "/dev/stderr"
        exit 2
      }
      srand(seed); r=rand()*total; acc=0
      for (i=1; i<=NR; i++) {
        acc+=w[i]
        if (r<acc) { print p[i]; exit }
      }
      print "wallpaper-pick: total pool weight is invalid" > "/dev/stderr"
      exit 2
    }'
}

if [[ "$DRY_RUN" == 1 ]]; then
  printf 'season=%s date=%s root=%s\n' "$SEASON" "$now_mmdd" "$ROOT"
  printf '%-6s  %s\n' "WEIGHT" "IMAGE"
  for e in "${POOL[@]}"; do
    printf '%-8s%s\n' "${e%%$'\t'*}" "${e#*$'\t'}"
  done
  printf 'total weight: %s across %s images\n' "$total_weight" "${#POOL[@]}"
  exit 0
fi

if [[ "$SIMULATE" -gt 0 ]]; then
  declare -A COUNTS=()
  for ((i = 0; i < SIMULATE; i++)); do
    p=$(pick_one)
    COUNTS["$p"]=$(( ${COUNTS["$p"]:-0} + 1 ))
  done
  for k in "${!COUNTS[@]}"; do
    printf '%5d  %s\n' "${COUNTS[$k]}" "$k"
  done | sort -rn
  exit 0
fi

img=$(pick_one)
mkdir -p "$(dirname "$STATE_FILE")"
state_tmp=$(mktemp "${STATE_FILE}.tmp.XXXXXX")
printf '%s\n' "$img" > "$state_tmp"
mv -f "$state_tmp" "$STATE_FILE"
if [[ -f "$PID_FILE" ]]; then
  old_pid=$(<"$PID_FILE")
  if [[ "$old_pid" =~ ^[0-9]+$ ]] &&
     [[ "$(ps -p "$old_pid" -o comm= 2>/dev/null | tr -d '[:space:]')" == "swaybg" ]]; then
    kill "$old_pid" 2>/dev/null || true
  else
    pkill -x swaybg 2>/dev/null || true
  fi
else
  pkill -x swaybg 2>/dev/null || true
fi
swaybg -i "$img" -m fill >/dev/null 2>&1 &
printf '%s\n' "$!" > "$PID_FILE"
disown || true
echo "$img"
